{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/cotacao",
      "destination": "/orcamento/",
      "permanent": true
    },
    {
      "source": "/empresas/orcamento",
      "destination": "/orcamento/",
      "permanent": true
    },
    {
      "source": "/sobre",
      "destination": "/a-tower/",
      "permanent": true
    },
    {
      "source": "/quem-somos",
      "destination": "/a-tower/",
      "permanent": true
    },
    {
      "source": "/empresa",
      "destination": "/a-tower/",
      "permanent": true
    },
    {
      "source": "/parceiros",
      "destination": "/marcas/",
      "permanent": true
    },
    {
      "source": "/produtos",
      "destination": "/protecao/",
      "permanent": true
    },
    {
      "source": "/calcados",
      "destination": "/calcados/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/conhecimento/",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/conhecimento/:slug/",
      "permanent": true
    }
  ]
}
